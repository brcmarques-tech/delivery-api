  "nodes": [
    {
      "id": "customer-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "customer-ai-agent",
      "name": "Customer AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        300,
        300
      ],
      "parameters": {
        "agent": "toolsAgent",
        "promptType": "define",
        "text": "={{ $json.text }}",
        "systemMessage": "Você é um assistente de atendimento ao cliente do aplicativo bcmTech Shopping.\nResponda via WhatsApp de forma amigável e concisa.\nVocê pode: consultar pedidos, cancelar pedidos pendentes e rastrear entregas em andamento do cliente {{ $json.customerName }}.\nNão pode cancelar pedidos já em preparo ou entregues.\nPara rastreamento, use o número do pedido fornecido pelo cliente.\nResponda sempre em português brasileiro.\nData/hora atual: {{ $now }}",
        "options": {
          "maxIterations": 5,
          "returnIntermediateSteps": false
        }
      }
    },
    {
      "id": "customer-send",
      "name": "Send Customer Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WAHA_API_URL }}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.WAHA_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chatId",
              "value": "={{ $('Execute Workflow Trigger').item.json.phone }}@c.us"
            },
            {
              "name": "text",
              "value": "={{ $json.output }}"
            },
            {
              "name": "session",
              "value": "default"
            }
          ]
        }
      }
    },
    {
      "id": "customer-memory",
      "name": "Redis Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryRedisChat",
      "typeVersion": 1.3,
      "position": [
        300,
        500
      ],
      "parameters": {
        "sessionKey": "=customer:{{ $('Execute Workflow Trigger').item.json.phone }}",
        "contextWindowLength": 10,
        "sessionIdType": "customKey",
        "sessionTTL": 86400
      },
      "credentials": {
        "redis": {
          "id": "JcbQEHqszYq4BrJr",
          "name": "Redis Shopping Prod"
        }
      }
    },
    {
      "id": "customer-llm",
      "name": "Gemini Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        150,
        500
      ],
      "parameters": {
        "modelName": "gemini-2.0-flash",
        "options": {
          "temperature": 0.3
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "mVtzjfZhFsbxFIlF",
          "name": "Google Gemini"
        }
      }
    },
    {
      "id": "tool-my-orders",
      "name": "Get My Orders",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        300,
        650
      ],
      "parameters": {
        "description": "Busca todos os pedidos do cliente. Retorna lista com status e detalhes.",
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/n8n/orders/customer",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "customerId",
              "valueProvider": "fieldValue",
              "value": "={{ $('Execute Workflow Trigger').item.json.customerId }}"
            }
          ]
        },
        "sendHeaders": true,
        "parametersHeaders": {
          "values": [
            {
              "name": "X-N8N-Key",
              "value": "={{ $env.N8N_AGENT_KEY }}"
            }
          ]
        },
        "optimizeResponse": true,
        "responseOptimization": "removeFields",
        "fieldsToRemove": "updatedAt,deletedAt"
      }
    },
    {
      "id": "tool-order-number",
      "name": "Get Order by Number",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        450,
        650
      ],
      "parameters": {
        "description": "Busca detalhes de um pedido específico pelo número do pedido.",
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/n8n/orders/number/{orderNumber}",
        "sendQuery": true,
        "sendPlaceholders": true,
        "placeholderDefinitions": {
          "values": [
            {
              "name": "orderNumber",
              "description": "Número do pedido (ex: 1001)",
              "required": true
            }
          ]
        },
        "sendHeaders": true,
        "parametersHeaders": {
          "values": [
            {
              "name": "X-N8N-Key",
              "value": "={{ $env.N8N_AGENT_KEY }}"
            }
          ]
        },
        "parametersQuery": {
          "values": [
            {
              "name": "customerId",
              "valueProvider": "fieldValue",
              "value": "={{ $('Execute Workflow Trigger').item.json.customerId }}"
            }
          ]
        }
      }
    },
    {
      "id": "tool-cancel-order",
      "name": "Cancel Order",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        600,
        650
      ],
      "parameters": {
        "description": "Cancela um pedido. Só funciona para pedidos PENDING. Forneça o orderNumber.",
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/n8n/orders/status",
        "sendBody": true,
        "parametersBody": {
          "values": [
            {
              "name": "orderNumber",
              "valueProvider": "modelRequired"
            },
            {
              "name": "status",
              "valueProvider": "fieldValue",
              "value": "CANCELLED"
            },
            {
              "name": "customerId",
              "valueProvider": "fieldValue",
              "value": "={{ $('Execute Workflow Trigger').item.json.customerId }}"
            }
          ]
        },
        "sendHeaders": true,
        "parametersHeaders": {
          "values": [
            {
              "name": "X-N8N-Key",
              "value": "={{ $env.N8N_AGENT_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "tool-tracking",
      "name": "Track Order Delivery",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        750,
