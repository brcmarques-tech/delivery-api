      ],
      "parameters": {
        "description": "Rastreia a entrega de um pedido em tempo real: status, entregador, ETA e localização. Use quando o cliente perguntar onde está seu pedido.",
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/n8n/orders/{orderNumber}/tracking",
        "sendPlaceholders": true,
        "placeholderDefinitions": {
