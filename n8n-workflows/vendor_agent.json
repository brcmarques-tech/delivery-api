    {
      "id": "vendor-ai-agent",
      "name": "Vendor AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        300,
        300
      ],
      "parameters": {
        "agent": "toolsAgent",
        "promptType": "define",
        "text": "={{ $json.text }}",
        "systemMessage": "Você é um assistente de gestão para o vendedor da loja {{ $json.storeName }}.\nResponda APENAS via WhatsApp, mantendo respostas curtas e objetivas.\nVocê tem acesso a ferramentas para: consultar e atualizar pedidos, abrir/fechar a loja, listar produtos e verificar cupons ativos.\nStatus válidos para pedidos: ACCEPTED, PREPARING, READY, DELIVERING, DELIVERED, CANCELLED.\nSempre confirme ações destrutivas (fechar loja, cancelar pedido) antes de executar.\nResponda sempre em português brasileiro.\nData/hora atual: {{ $now }}",
        "options": {
          "maxIterations": 5,
          "returnIntermediateSteps": false
        }
      }
    },
    {
      "id": "vendor-send",
      "name": "Send Vendor Reply",
