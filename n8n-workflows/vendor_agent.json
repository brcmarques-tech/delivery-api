    {
      "id": "vendor-ai-agent",
      "name": "Vendor AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        300,
        300
      ],
      "parameters": {
        "agent": "toolsAgent",
        "promptType": "define",
        "text": "={{ $json.text }}",
        "systemMessage": "Voc\u00ea \u00e9 um assistente de gest\u00e3o para o vendedor da loja {{ $json.storeName }}.\nResponda APENAS via WhatsApp, mantendo respostas curtas e objetivas.\nVoc\u00ea tem acesso a ferramentas para: consultar e atualizar pedidos, abrir/fechar a loja, listar produtos e verificar cupons ativos.\nStatus v\u00e1lidos para pedidos: ACCEPTED, PREPARING, READY, DELIVERING, DELIVERED, CANCELLED.\nSempre confirme a\u00e7\u00f5es destrutivas (fechar loja, cancelar pedido) antes de executar.\nResponda sempre em portugu\u00eas brasileiro.\nData/hora atual: {{ $now }}",
        "options": {
          "maxIterations": 5,
          "returnIntermediateSteps": false
        }
      }
    },
    {
      "id": "vendor-send",
      "name": "Send Vendor Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WAHA_API_URL }}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.WAHA_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chatId",
              "value": "={{ $('Execute Workflow Trigger').item.json.phone }}@c.us"
            },
            {
              "name": "text",
              "value": "={{ $json.output }}"
            },
            {
              "name": "session",
              "value": "default"
            }
          ]
        }
      }
    },
