# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shopping
DB_PASSWORD=shopping123
DB_DATABASE=shopping_db

# Database TLS (KAN-232) — so vale quando DATABASE_URL esta definida (prod).
# Por padrao a API valida o certificado do Postgres. Se o provedor usa cert
# self-signed, forneca a CA (recomendado) OU use o escape hatch explicito.
# DB_SSL_CA=                       # conteudo PEM da CA (use \n literais)
# DB_SSL_CA_FILE=/path/ca.pem      # ou o caminho para o arquivo PEM da CA
# DB_SSL_REJECT_UNAUTHORIZED=false # escape hatch: NAO valida o cert (loga aviso)
# DB_SSL=false                     # desliga o TLS por completo (rede confiavel)

# JWT
JWT_SECRET=sua-chave-secreta-aqui
JWT_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App
PORT=3000

# Security
PASSWORD_PEPPER=

# Sentry
SENTRY_DSN=

# ─── KAN-29: distancia de entrega por ROTA (OpenRouteService) ────────────
# Sem ORS_API_KEY o frete continua sendo calculado em LINHA RETA, como antes
# — nada muda. Com a chave, a distancia passa a ser a da rota de carro.
#
# ATENCAO AO LIGAR: o frete medio SOBE (a rota real e maior que a linha
# reta; em Pelotas, uns 30%). Revisar deliveryPricePerKm/deliveryBasePrice
# no painel do superadmin faz parte de ligar isto.
#
# Chave gratuita em https://openrouteservice.org/dev/#/signup
# (plano gratuito: 2.000 chamadas/dia, 40/min — ha cache de 24h e freio por
# minuto no DistanciaService para a cota nao estourar)
ORS_API_KEY=
# ORS_URL=https://api.openrouteservice.org/v2/directions/driving-car
# ORS_MAX_POR_MINUTO=30
# ORS_TIMEOUT_MS=2500
