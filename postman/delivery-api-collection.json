    {
      "name": "4. Pedidos - Criar",
      "description": "Criar pedidos com diferentes metodos de pagamento. Requer login do cliente (pasta 1).",
      "item": [
        {
          "name": "4.1 Pedido ON_DELIVERY (retirada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.createOrder) {",
                  "  const o = res.data.createOrder;",
                  "  pm.environment.set('orderId', o.id);",
                  "  pm.environment.set('orderNumber', o.orderNumber);",
                  "  pm.test('Pedido ' + o.orderNumber + ' criado', () => pm.expect(o.status).to.eql('PENDING'));",
                  "  pm.test('Total: R$' + o.total.toFixed(2), () => pm.expect(o.total).to.be.above(0));",
                  "  pm.test('Pickup = true', () => pm.expect(o.isPickup).to.be.true);",
                  "  pm.test('Delivery fee = 0', () => pm.expect(o.deliveryFee).to.eql(0));",
                  "} else {",
                  "  pm.test('Erro: ' + (res.errors?.[0]?.message || 'desconhecido'), () => pm.expect.fail());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: CreateOrderInput!) {\n  createOrder(input: $input) {\n    id\n    orderNumber\n    status\n    total\n    subtotal\n    deliveryFee\n    commissionPercent\n    commissionAmount\n    paymentMethod\n    isPickup\n  }\n}",
                "variables": "{\"input\":{\"storeId\":\"{{storeId}}\",\"items\":[{\"productId\":\"{{productId1}}\",\"quantity\":2}],\"paymentMethod\":\"ON_DELIVERY\",\"isPickup\":true}}"
              }
            }
          }
        },
        {
          "name": "4.2 Pedido ON_DELIVERY (entrega)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.createOrder) {",
                  "  const o = res.data.createOrder;",
                  "  pm.environment.set('orderId', o.id);",
                  "  pm.environment.set('orderNumber', o.orderNumber);",
                  "  pm.test('Pedido entrega ' + o.orderNumber, () => pm.expect(o.status).to.eql('PENDING'));",
                  "  pm.test('Delivery fee > 0: R$' + o.deliveryFee.toFixed(2), () => pm.expect(o.deliveryFee).to.be.above(0));",
                  "  pm.test('Endereco: ' + o.deliveryAddress, () => pm.expect(o.deliveryAddress).to.not.be.empty);",
                  "} else {",
                  "  pm.test('Erro: ' + (res.errors?.[0]?.message || 'desconhecido'), () => pm.expect.fail());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: CreateOrderInput!) {\n  createOrder(input: $input) {\n    id\n    orderNumber\n    status\n    total\n    subtotal\n    deliveryFee\n    commissionPercent\n    commissionAmount\n    paymentMethod\n    isPickup\n    deliveryAddress\n  }\n}",
                "variables": "{\"input\":{\"storeId\":\"{{storeId}}\",\"items\":[{\"productId\":\"{{productId1}}\",\"quantity\":2},{\"productId\":\"{{productId2}}\",\"quantity\":1}],\"paymentMethod\":\"ON_DELIVERY\",\"deliveryAddress\":\"Rua Andrade Neves, 200 - Centro, Pelotas - RS\",\"deliveryLatitude\":-31.77,\"deliveryLongitude\":-52.34}}"
              }
            }
          }
        },
        {
          "name": "4.3 Pedido PIX",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.createOrder) {",
                  "  const o = res.data.createOrder;",
                  "  pm.environment.set('orderId', o.id);",
                  "  pm.environment.set('orderNumber', o.orderNumber);",
                  "  if (o.checkoutUrl) pm.environment.set('checkoutUrl', o.checkoutUrl);",
                  "  pm.test('PIX ' + o.orderNumber + ' - AWAITING_PAYMENT', () => pm.expect(o.status).to.eql('AWAITING_PAYMENT'));",
                  "  pm.test('QR Code gerado', () => pm.expect(o.pixQrCode || o.checkoutUrl).to.not.be.empty);",
                  "  pm.test('Pagar.me order: ' + o.mpPreferenceId, () => pm.expect(o.mpPreferenceId).to.not.be.empty);",
                  "} else {",
                  "  pm.test('Erro: ' + (res.errors?.[0]?.message || 'desconhecido'), () => pm.expect.fail());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: CreateOrderInput!) {\n  createOrder(input: $input) {\n    id\n    orderNumber\n    status\n    total\n    subtotal\n    deliveryFee\n    commissionPercent\n    commissionAmount\n    paymentMethod\n    checkoutUrl\n    pixQrCode\n    pixQrCodeBase64\n    mpPreferenceId\n  }\n}",
                "variables": "{\"input\":{\"storeId\":\"{{storeId}}\",\"items\":[{\"productId\":\"{{productId1}}\",\"quantity\":1},{\"productId\":\"{{productId2}}\",\"quantity\":1}],\"paymentMethod\":\"PIX\",\"deliveryAddress\":\"Rua Andrade Neves, 200 - Centro, Pelotas - RS\",\"deliveryLatitude\":-31.77,\"deliveryLongitude\":-52.34}}"
              }
            }
          }
        },
        {
          "name": "4.4 Tokenizar Cartao (Pagar.me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.environment.set('cardToken', res.id);",
                  "  pm.test('Card token gerado: ' + res.id, () => pm.expect(res.id).to.be.a('string'));",
