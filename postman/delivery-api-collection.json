                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  confirmReceipt(orderId: \"{{orderId}}\") {\n    id\n    orderNumber\n    status\n    customerConfirmedAt\n    delivery {\n      payoutStatus\n      payoutAmount\n      vendorPayoutStatus\n      vendorPayoutAmount\n    }\n  }\n}"
              }
            }
          }
        },
        {
          "name": "6.2 Verificar Separação de Valores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.order) {",
                  "  const o = res.data.order;",
                  "  const d = o.delivery;",
                  "",
                  "  const subtotal = parseFloat(o.subtotal);",
                  "  const deliveryFee = parseFloat(o.deliveryFee);",
                  "  const total = parseFloat(o.total);",
                  "  const commission = parseFloat(o.commissionAmount);",
                  "  const vendorAmount = d ? parseFloat(d.vendorPayoutAmount || 0) : 0;",
                  "  const delivererAmount = d ? parseFloat(d.payoutAmount || 0) : 0;",
                  "",
                  "  const totalDistribuido = vendorAmount + delivererAmount + commission;",
                  "",
                  "  console.log('══════════════════════════════════');",
                  "  console.log('  SEPARACAO DE VALORES');",
                  "  console.log('══════════════════════════════════');",
                  "  console.log('Subtotal:     R$ ' + subtotal.toFixed(2));",
                  "  console.log('Entrega:      R$ ' + deliveryFee.toFixed(2));",
                  "  console.log('TOTAL:        R$ ' + total.toFixed(2));",
                  "  console.log('──────────────────────────────────');",
                  "  console.log('Vendedor:     R$ ' + vendorAmount.toFixed(2) + ' (' + (d ? d.vendorPayoutStatus : 'n/a') + ')');",
                  "  console.log('Entregador:   R$ ' + delivererAmount.toFixed(2) + ' (' + (d ? d.payoutStatus : 'n/a') + ')');",
                  "  console.log('Plataforma:   R$ ' + commission.toFixed(2) + ' (' + o.commissionPercent + '%)');",
                  "  console.log('──────────────────────────────────');",
                  "  console.log('Distribuido:  R$ ' + totalDistribuido.toFixed(2));",
                  "  console.log('Cobrado:      R$ ' + total.toFixed(2));",
                  "",
                  "  pm.test('Valores batem: R$' + totalDistribuido.toFixed(2) + ' = R$' + total.toFixed(2), () => {",
                  "    pm.expect(Math.abs(totalDistribuido - total)).to.be.below(0.01);",
                  "  });",
                  "",
                  "  if (d) {",
                  "    pm.test('Vendedor split_auto: R$' + vendorAmount.toFixed(2), () => {",
                  "      pm.expect(d.vendorPayoutStatus).to.equal('split_auto');",
                  "    });",
                  "    pm.test('Entregador pending: R$' + delivererAmount.toFixed(2), () => {",
                  "      pm.expect(['pending_confirmation', 'completed']).to.include(d.payoutStatus);",
                  "    });",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  order(id: \"{{orderId}}\") {\n    id\n    orderNumber\n    status\n    subtotal\n    deliveryFee\n    total\n    paymentMethod\n    commissionPercent\n    commissionAmount\n    customerConfirmedAt\n    store {\n      name\n      hasOwnDelivery\n    }\n    delivery {\n      id\n      payoutStatus\n      payoutAmount\n      payoutMpId\n      vendorPayoutStatus\n      vendorPayoutAmount\n      vendorPayoutMpId\n      deliveredAt\n      deliverer {\n        name\n      }\n    }\n  }\n}"
              }
            }
          }
        }
