          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "https://api.pagar.me/core/v5/tokens?appId=pk_Vk52emF9afzp2z8d", "host": ["https://api.pagar.me/core/v5/tokens?appId=pk_Vk52emF9afzp2z8d"] },
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"card\",\"card\":{\"number\":\"4000000000000010\",\"holder_name\":\"TESTE BCMTECH\",\"exp_month\":12,\"exp_year\":2030,\"cvv\":\"123\"}}"
            }
          }
        },
        {
          "name": "4.5 Pedido Cartao de Credito (com Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.createOrder) {",
                  "  const o = res.data.createOrder;",
                  "  pm.environment.set('orderId', o.id);",
                  "  pm.environment.set('orderNumber', o.orderNumber);",
                  "  pm.test('Cartao ' + o.orderNumber + ' - status: ' + o.status, () => {",
                  "    pm.expect(['PENDING', 'AWAITING_PAYMENT']).to.include(o.status);",
                  "  });",
                  "  pm.test('Pagar.me order ID salvo', () => pm.expect(o.mpPreferenceId).to.be.a('string'));",
                  "} else {",
                  "  pm.test('Erro: ' + (res.errors?.[0]?.message || 'desconhecido'), () => pm.expect.fail());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
