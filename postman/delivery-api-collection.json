    {
      "name": "2. Setup (Loja + Produto)",
      "description": "Cria loja e produto para teste. Pule se já existirem.",
      "item": [
        {
          "name": "Listar Lojas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.stores && res.data.stores.length > 0) {",
                  "  const store = res.data.stores[0];",
                  "  pm.environment.set('storeId', store.id);",
                  "  pm.test('Loja encontrada: ' + store.name, () => {",
                  "    pm.expect(store.id).to.be.a('string');",
                  "  });",
                  "} else {",
                  "  pm.test('Nenhuma loja - execute Criar Loja', () => {",
                  "    pm.expect(res.data.stores).to.be.an('array');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  stores {\n    id\n    name\n    isOpen\n    deliveryFee\n    hasOwnDelivery\n    ownerMpConnected\n    products {\n      id\n      name\n      price\n      stock\n      isAvailable\n    }\n  }\n}"
