    {
      "name": "3. Pedidos",
      "description": "Criar e gerenciar pedidos.",
      "item": [
        {
          "name": "Criar Pedido (MERCADO_PAGO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.createOrder) {",
                  "  const order = res.data.createOrder;",
                  "  pm.environment.set('orderId', order.id);",
                  "  pm.environment.set('orderNumber', order.orderNumber);",
                  "  if (order.checkoutUrl) pm.environment.set('checkoutUrl', order.checkoutUrl);",
                  "",
                  "  pm.test('Pedido criado: #' + order.orderNumber, () => {",
                  "    pm.expect(order.id).to.be.a('string');",
                  "    pm.expect(order.status).to.equal('AWAITING_PAYMENT');",
                  "  });",
                  "",
                  "  // Log valores",
                  "  console.log('--- VALORES DO PEDIDO ---');",
                  "  console.log('Subtotal: R$' + order.subtotal);",
                  "  console.log('Taxa entrega: R$' + order.deliveryFee);",
                  "  console.log('Total: R$' + order.total);",
                  "  console.log('Comissao: ' + order.commissionPercent + '% = R$' + order.commissionAmount);",
                  "  if (order.checkoutUrl) console.log('Checkout: ' + order.checkoutUrl);",
                  "} else {",
                  "  pm.test('Criar pedido falhou', () => pm.expect.fail(JSON.stringify(res.errors)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: CreateOrderInput!) {\n  createOrder(input: $input) {\n    id\n    orderNumber\n    status\n    subtotal\n    deliveryFee\n    total\n    paymentMethod\n    checkoutUrl\n    mpPreferenceId\n    commissionPercent\n    commissionAmount\n    deliveryAddress\n    store {\n      id\n      name\n    }\n    items {\n      id\n      quantity\n      unitPrice\n      totalPrice\n      product {\n        name\n      }\n    }\n    createdAt\n  }\n}",
                "variables": "{\"input\":{\"storeId\":\"{{storeId}}\",\"items\":[{\"productId\":\"{{productId}}\",\"quantity\":2}],\"paymentMethod\":\"MERCADO_PAGO\",\"deliveryAddress\":\"Rua Postman Test, 123 - Centro\",\"deliveryLatitude\":-31.7654,\"deliveryLongitude\":-52.3456}}"
              }
            }
          }
