      "name": "6. Confirmação + Valores",
      "description": "Cliente confirma recebimento e verificamos a separação de valores.",
      "item": [
        {
          "name": "6.1 Cliente Confirma Recebimento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
