{
  "info": {
    "name": "Delivery API - Fluxo Completo",
    "_postman_id": "delivery-api-collection",
    "description": "Collection completa da Delivery API (Pagar.me).\n\n## Como usar:\n1. Importe o environment \"Delivery API\"\n2. Execute as requests na ordem das pastas\n3. Os tokens e IDs sao salvos automaticamente nas variaveis\n\n## Fluxo de Pagamento:\n1. Login (Auth) → tokens salvos\n2. Consultar Loja + Produtos (Setup)\n3. Criar Pedido (PIX, Cartao, ON_DELIVERY)\n4. Fluxo Vendedor (Aceitar → Preparar → Pronto → Entregar)\n5. Consultas (Dashboard, Pedidos)\n\n## Dados atuais:\n- Loja: Loja Teste BCM (Pelotas)\n- Produtos: X-Burger (R$25.90), Coca-Cola (R$6.00)\n- Cliente: teste@bcmtech.com / teste123 (com CPF)\n- Vendedor: admin@bcmtech.com / admin123 (com Pagar.me)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "1. Auth",
      "description": "Login de todos os usuarios. Execute na ordem. Tokens sao salvos automaticamente.",
      "item": [
        {
          "name": "1.1 Login Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.loginApp) {",
                  "  pm.environment.set('customerToken', res.data.loginApp.accessToken);",
                  "  pm.environment.set('customerId', res.data.loginApp.user.id);",
                  "  pm.test('Login cliente OK - ' + res.data.loginApp.user.name, () => {",
                  "    pm.expect(res.data.loginApp.accessToken).to.be.a('string');",
                  "  });",
                  "} else {",
                  "  const msg = res.errors?.[0]?.message || 'erro desconhecido';",
                  "  pm.test('Login cliente falhou: ' + msg, () => pm.expect.fail(msg));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginApp($input: LoginInput!, $forceLogin: Boolean) {\n  loginApp(input: $input, forceLogin: $forceLogin) {\n    accessToken\n    user {\n      id\n      name\n      email\n      cpf\n      phone\n      role\n      isDeliverer\n      paymentConnected\n      emailVerified\n      phoneVerified\n      acceptedTermsAt\n    }\n  }\n}",
                "variables": "{\"input\":{\"email\":\"{{customerEmail}}\",\"password\":\"{{customerPassword}}\"},\"forceLogin\":true}"
              }
            }
          }
        },
        {
          "name": "1.2 Login Vendedor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.loginVendor) {",
                  "  pm.environment.set('vendorToken', res.data.loginVendor.accessToken);",
                  "  pm.environment.set('vendorId', res.data.loginVendor.user.id);",
                  "  pm.test('Login vendedor OK - ' + res.data.loginVendor.user.name, () => {",
                  "    pm.expect(res.data.loginVendor.accessToken).to.be.a('string');",
                  "  });",
                  "} else {",
                  "  const msg = res.errors?.[0]?.message || 'erro desconhecido';",
                  "  pm.test('Login vendedor falhou: ' + msg, () => pm.expect.fail(msg));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginVendor($input: LoginInput!, $forceLogin: Boolean) {\n  loginVendor(input: $input, forceLogin: $forceLogin) {\n    accessToken\n    user {\n      id\n      name\n      email\n      phone\n      role\n      pagarmeRecipientId\n      paymentConnected\n      vendorPlan\n      emailVerified\n      phoneVerified\n    }\n  }\n}",
                "variables": "{\"input\":{\"email\":\"{{vendorEmail}}\",\"password\":\"{{vendorPassword}}\"},\"forceLogin\":true}"
              }
            }
          }
        },
        {
          "name": "1.3 Login Entregador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.loginApp) {",
                  "  pm.environment.set('delivererToken', res.data.loginApp.accessToken);",
                  "  pm.environment.set('delivererId', res.data.loginApp.user.id);",
                  "  pm.test('Login entregador OK', () => {",
                  "    pm.expect(res.data.loginApp.accessToken).to.be.a('string');",
                  "  });",
                  "} else {",
                  "  const msg = res.errors?.[0]?.message || 'erro desconhecido';",
                  "  pm.test('Login entregador falhou: ' + msg, () => pm.expect.fail(msg));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginApp($input: LoginInput!, $forceLogin: Boolean) {\n  loginApp(input: $input, forceLogin: $forceLogin) {\n    accessToken\n    user {\n      id\n      name\n      email\n      role\n      isDeliverer\n      paymentConnected\n    }\n  }\n}",
                "variables": "{\"input\":{\"email\":\"{{delivererEmail}}\",\"password\":\"{{delivererPassword}}\"},\"forceLogin\":true}"
              }
            }
          }
        },
        {
          "name": "1.4 Login Superadmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.loginApp) {",
                  "  pm.environment.set('superadminToken', res.data.loginApp.accessToken);",
                  "  pm.test('Login superadmin OK', () => {",
                  "    pm.expect(res.data.loginApp.user.role).to.eql('SUPERADMIN');",
                  "  });",
                  "} else {",
                  "  const msg = res.errors?.[0]?.message || 'erro desconhecido';",
                  "  pm.test('Login superadmin falhou: ' + msg, () => pm.expect.fail(msg));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginApp($input: LoginInput!, $forceLogin: Boolean) {\n  loginApp(input: $input, forceLogin: $forceLogin) {\n    accessToken\n    user {\n      id\n      name\n      email\n      role\n    }\n  }\n}",
                "variables": "{\"input\":{\"email\":\"{{superadminEmail}}\",\"password\":\"{{superadminPassword}}\"},\"forceLogin\":true}"
              }
            }
          }
        }
      ]
    },
