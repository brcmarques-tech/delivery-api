          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  stores {\n    id\n    name\n    isOpen\n    hasOwnDelivery\n    deliveryFee\n    minimumOrder\n    freeDelivery\n    freeDeliveryAbove\n    estimatedDeliveryMinutes\n    owner {\n      id\n      name\n      email\n      pagarmeRecipientId\n      paymentConnected\n    }\n  }\n}"
              }
            }
          }
        },
        {
          "name": "2.4 Minhas Lojas (vendor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.myStores?.length > 0) {",
                  "  const store = res.data.myStores[0];",
                  "  pm.environment.set('storeId', store.id);",
                  "  if (store.products?.length > 0) {",
                  "    pm.environment.set('productId1', store.products[0].id);",
                  "    if (store.products.length > 1) pm.environment.set('productId2', store.products[1].id);",
                  "  }",
                  "  pm.test('Loja: ' + store.name + ' (' + (store.products?.length || 0) + ' produtos)', () => pm.expect(store.id).to.not.be.empty);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": { "raw": "{{graphqlUrl}}", "host": ["{{graphqlUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  myStores {\n    id\n    name\n    isOpen\n    hasOwnDelivery\n    deliveryFee\n    products {\n      id\n      name\n      price\n      stock\n      isAvailable\n    }\n  }\n}"
              }
            }
          }
        }
      ]
